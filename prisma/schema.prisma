generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  name      String?
  email     String     @unique
  password  String?
  image     String?
  role      String     @default("USER")
  ageGroup  String?
  favorites Favorite[]
  accounts  Account[]
  sessions  Session[]
  createdAt DateTime   @default(now())
}

model Category {
  id        String      @id @default(cuid())
  name      String
  slug      String      @unique
  type      String
  icon      String?
  sortOrder Int         @default(0)
  contents  Content[]
}

model Content {
  id          String      @id @default(cuid())
  type        String
  title       String
  slug        String      @unique
  subtitle    String?
  description String?
  body        String?
  coverUrl    String?
  audioUrl    String?
  videoUrl    String?
  pdfUrl      String?
  ageMin      Int         @default(2)
  ageMax      Int         @default(7)
  durationSec Int         @default(180)
  languages   String      @default("th")
  narration   String      @default("AUDIO")
  categoryId  String?
  category    Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags        String      @default("")
  isPublished Boolean     @default(false)
  isFeatured  Boolean     @default(false)
  views       Int         @default(0)
  sortOrder   Int         @default(0)
  favorites   Favorite[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([type, isPublished])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, contentId])
}

model Banner {
  id       String      @id @default(cuid())
  type     String      @unique
  eyebrow  String?
  title    String
  subtitle String?
  imageUrl String?
  isActive Boolean     @default(true)
}

model SiteSetting {
  key   String @id
  value String
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
